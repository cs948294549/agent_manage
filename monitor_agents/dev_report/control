#!/bin/bash

WORKSPACE=$(cd $(dirname $0)/; pwd)
cd $WORKSPACE

mkdir -p var

app=ip_reporter
pidfile=var/app.pid
logfile=var/report.log

function check_pid() {
    if [ -f $pidfile ];then
        pid=$(cat $pidfile)
        if [ -n "$pid" ]; then
            running=$(ps -p $pid 2>/dev/null | grep -v "PID TTY" | wc -l)
            return $running
        fi
    fi
    return 0
}

function start() {
    check_pid
    running=$?
    if [ $running -gt 0 ];then
        echo -n "$app now is running already, pid="
        cat $pidfile
        return 1
    fi

    nohup bash ./$app.sh &> $logfile &
    echo $! > $pidfile
    echo "$app started..., pid=$!"
}

function stop() {
    check_pid
    running=$?
    if [ $running -eq 0 ];then
        echo "$app is not running"
        return 0
    fi
    pid=$(cat $pidfile)
    kill $pid 2>/dev/null
    sleep 1
    kill -0 $pid 2>/dev/null && kill -9 $pid 2>/dev/null
    rm -f $pidfile
    echo "$app stoped..."
}

function restart() {
    stop
    sleep 1
    start
}

function status() {
    check_pid
    running=$?
    if [ $running -gt 0 ];then
        echo "started"
    else
        echo "stoped"
    fi
}

function tailf() {
    tail -f $logfile
}

function help() {
    echo "Usage: $0 {start|stop|restart|status|tail|pid}"
}

function pid() {
    if [ -f $pidfile ]; then
        cat $pidfile
    else
        echo "not running"
    fi
}

case "$1" in
    start)    start ;;
    stop)     stop ;;
    restart)  restart ;;
    status)   status ;;
    tail)     tailf ;;
    pid)      pid ;;
    *)        help ;;
esac
